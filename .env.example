# Optional server-side AI Repair configuration.
# VYVO works completely without any API key!
# Configuring one of these enables automatic server-backed "FIX IT WITH AI" for all users.

# Choose default provider: "gemini" | "openai" | "anthropic"
VYVO_AI_PROVIDER=gemini

# Provide the key for your preferred provider (never exposed to browser clients):
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
